    <!-- Permissions -->
    <string name="perm_title">Permission needed</string>
    <string name="perm_grant">Grant</string>
    <string name="perm_settings">Open app settings</string>
    <string name="perm_location">Location</string>
    <string name="perm_location_why">Android shows Wi-Fi scan results, cell identities, Bluetooth scans and GNSS satellites only to apps with location access.</string>
    <string name="perm_bt_scan">Nearby devices: scan</string>
    <string name="perm_bt_scan_why">Needed to find Bluetooth devices around you.</string>
    <string name="perm_bt_connect">Nearby devices: connect</string>
    <string name="perm_bt_connect_why">Needed to read the adapter name, address and paired devices, and to turn Bluetooth on.</string>
    <string name="perm_phone">Phone</string>
    <string name="perm_phone_why">Reads SIM state, network registration, signal and call state. No call is placed by the app.</string>
    <string name="perm_sms_send">Send SMS</string>
    <string name="perm_sms_send_why">Only for the SMS test, which sends one message to the number you type.</string>
    <string name="perm_sms_receive">Receive SMS</string>
    <string name="perm_sms_receive_why">Lets the SMS test notice when the message comes back to this phone.</string>
    <string name="perm_mic">Microphone</string>
    <string name="perm_mic_why">Records a few seconds from each microphone to check level and play it back. Nothing is saved.</string>
    <string name="perm_camera">Camera</string>
    <string name="perm_camera_why">Opens each camera to check that frames arrive and to show the preview.</string>
    <string name="perm_notifications">Notifications</string>
    <string name="perm_notifications_why">Used by the notification LED test and to show progress.</string>

