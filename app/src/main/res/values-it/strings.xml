    <string name="perm_location">Posizione</string>
    <string name="perm_location_why">Android mostra risultati della scansione Wi-Fi, identità delle celle, scansioni Bluetooth e satelliti GNSS solo alle app con accesso alla posizione.</string>
    <string name="perm_bt_scan">Dispositivi vicini: scansione</string>
    <string name="perm_bt_scan_why">Serve per trovare i dispositivi Bluetooth intorno a te.</string>
    <string name="perm_bt_connect">Dispositivi vicini: connessione</string>
    <string name="perm_bt_connect_why">Serve per leggere nome, indirizzo e dispositivi associati dell\'adattatore e per accendere il Bluetooth.</string>
    <string name="perm_phone">Telefono</string>
    <string name="perm_phone_why">Legge stato della SIM, registrazione alla rete, segnale e stato delle chiamate. L\'app non effettua chiamate.</string>
    <string name="perm_sms_send">Invio SMS</string>
    <string name="perm_sms_send_why">Solo per la prova SMS, che invia un messaggio al numero che scrivi.</string>
    <string name="perm_sms_receive">Ricezione SMS</string>
    <string name="perm_sms_receive_why">Permette alla prova SMS di accorgersi quando il messaggio torna a questo telefono.</string>
    <string name="perm_mic">Microfono</string>
    <string name="perm_mic_why">Registra pochi secondi da ogni microfono per controllare il livello e riascoltarli. Niente viene salvato.</string>
    <string name="perm_camera">Fotocamera</string>
    <string name="perm_camera_why">Apre ogni fotocamera per verificare che arrivino i fotogrammi e mostrare l\'anteprima.</string>
    <string name="perm_notifications">Notifiche</string>
    <string name="perm_notifications_why">Usate dalla prova del LED di notifica e per mostrare l\'avanzamento.</string>

